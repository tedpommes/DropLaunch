{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropLaunch",
  "version": "2.0.3",
  "identifier": "gg.droplaunch.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DropLaunch",
        "width": 640,
        "height": 950,
        "minWidth": 640,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1e2028"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "DropLaunch",
    "copyright": "© 2026 DropLaunch",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
