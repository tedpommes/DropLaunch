{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropLaunch",
  "version": "2.0.0",
  "identifier": "gg.droplaunch.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DropLaunch",
        "width": 640,
        "height": 950,
        "minWidth": 640,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1e2028"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "DropLaunch",
    "copyright": "© 2026 DropLaunch",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
